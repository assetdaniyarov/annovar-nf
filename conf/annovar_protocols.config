/*
================================================================================
    Default ANNOVAR protocols per genome build: the core set for clinical
    germline review, installed automatically on the first run into an empty
    humandb (--auto_install_db; hg38 about 30 GB to download, 185 GB on disk;
    hg19 about 15 GB, 75 GB). Only the builds of the input files are installed.

      gene models     refGene (HGVS in the report), knownGene (GENCODE)
      identifiers     avsnp151 (dbSNP rs numbers)
      frequencies     gnomAD exomes + genomes (rare-variant filter of the report)
      missense        REVEL (ClinGen-calibrated; report, inheritance analysis)
      classification  ClinVar (newest NCBI release), InterVar (automated ACMG),
                      PubMind (literature, hg38)

    Each entry is '<database>:<operation>' (g = gene-based, f = filter-based,
    r = region-based, gx = gene-based with cross-reference). The operation can
    be omitted for common databases: gene models (refGene, knownGene, ensGene,
    GENCODE ...) default to 'g', everything else to 'f'.

    Database files live in <annovar_db>/<build>_<database>.txt; missing ones are
    installed before annotation (or the run stops with --auto_install_db false).
    conf/dragen.config shows an extended set (dbNSFP with CADD and AlphaMissense,
    regSNP-intron, ...).

    Override for your site in a custom config (-c my.config), e.g.
        params.annovar_protocols.hg38 = ['refGene:g', 'gnomad41_genome:f', 'clinvar_latest:f']
    or for a single run with --protocol / --operation.
================================================================================
*/

params {
    annovar_protocols = [

        // hg38 - newest releases on the ANNOVAR download page (gnomAD 4.1,
        // InterVar 2025-07-21, PubMind 1.1.1) and ClinVar from NCBI
        hg38: [
            'refGene:g', 'knownGene:g',
            'avsnp151:f',
            'gnomad41_exome:f', 'gnomad41_genome:f',
            'revel:f',
            'clinvar_latest:f', 'intervar_20250721:f',
            'pubmind_db_v111:f',
        ],

        // hg19 - gnomAD 2.1.1 and InterVar 2018-01-18 are the newest hg19
        // releases on the ANNOVAR download page
        hg19: [
            'refGene:g', 'knownGene:g',
            'avsnp151:f',
            'gnomad211_exome:f', 'gnomad211_genome:f',
            'revel:f',
            'clinvar_latest:f', 'intervar_20180118:f',
        ],
    ]
}
