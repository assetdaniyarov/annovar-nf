/*
================================================================================
    Resource labels
    Transient failures (out of memory, killed by the scheduler) are retried
    with more memory/time; deterministic errors stop the run immediately
    instead of wasting hours on identical retries.
================================================================================
*/

process {
    cpus   = 1
    memory = { 4.GB * task.attempt }
    time   = { 4.h * task.attempt }

    // 104/134/137/139/140/143: killed (OOM, SIGKILL, walltime ...).
    errorStrategy = { task.exitStatus in ((130..145) + 104 + 175) ? 'retry' : 'finish' }
    maxRetries    = 2

    // resourceLimits (--max_cpus/--max_memory/--max_time) is set at the end of
    // nextflow.config, after the profiles that may change those params.

    withLabel: 'process_single' {
        cpus   = 1
        memory = { 2.GB * task.attempt }
        time   = { 2.h * task.attempt }
    }
    withLabel: 'process_low' {
        cpus   = 2
        memory = { 4.GB * task.attempt }
        time   = { 8.h * task.attempt }
    }
    withLabel: 'process_medium' {
        cpus   = 4
        memory = { 8.GB * task.attempt }
        time   = { 24.h * task.attempt }
    }
    withLabel: 'process_annovar' {
        // The chunks of a file share its --threads (meta.cpus, set by the workflow).
        cpus   = { meta.cpus ?: params.threads.toString().toInteger() }
        // An ANNOVAR process needs under 1 GB plus its query lines, which hold
        // every sample column of the input (convert2annovar -includeinfo -allsample):
        // ~20x the compressed chunk covers a 400-sample cohort. Requests sized to
        // the chunk let the local executor run one chunk per CPU at the same time.
        memory = { (2.GB + 1.GB * task.cpus + (20L * vcf.size()).intdiv(1048576).MB) * task.attempt }
        time   = { 48.h * task.attempt }
    }
}
