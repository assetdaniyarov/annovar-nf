/*
================================================================================
    Site profile: DRAGEN servers (local executor, Oracle Linux 8)
    Use with:  -profile dragen
    ANNOVAR 2025-03-02 with its humandb on the local SSD.
    Database versions: the newest releases on the ANNOVAR download page
    (hg38: dbNSFP 5.4a with InterPro domains, InterVar 2025-07-21, gnomAD 4.1;
    hg19: dbNSFP 4.7a, gnomAD 2.1.1) and the newest NCBI ClinVar build
    (clinvar_latest).
================================================================================
*/

params {
    annovar_src = '/staging/adaniyarov/annovar-nf/annovar_20250302'
    annovar_db  = '/staging/adaniyarov/annovar-nf/annovar_20250302/humandb'

    threads     = 8
    // Leave headroom for the OS, DRAGEN services and interactive users: use
    // 3/4 of the machine's CPUs and RAM (detected, so the profile works on
    // any server). Larger --threads are capped to max_cpus.
    max_cpus    = Math.max(1, (Runtime.getRuntime().availableProcessors() * 3).intdiv(4))
    max_memory  = "${(java.lang.management.ManagementFactory.getOperatingSystemMXBean().getTotalMemorySize() * 0.75 / 1073741824).longValue()}.GB"
    max_time    = '240.h'

    annovar_protocols = [
        hg38: [
            'refGene:g', 'knownGene:g', 'ensGene:g',
            'avsnp151:f',
            'ALL.sites.2015_08:f', 'AFR.sites.2015_08:f', 'SAS.sites.2015_08:f',
            'EUR.sites.2015_08:f', 'EAS.sites.2015_08:f',
            'cosmic70:f',
            'exac03:f',
            'gnomad41_exome:f', 'gnomad41_genome:f',
            'revel:f', 'nci60:f',
            'clinvar_latest:f', 'intervar_20250721:f',
            'dbnsfp54a:f',
            'regsnpintron:f',
            'pubmind_db_v111:f',
        ],
        hg19: [
            'refGene:g', 'knownGene:g', 'ensGene:g',
            'avsnp151:f',
            'ALL.sites.2015_08:f', 'AFR.sites.2015_08:f', 'AMR.sites.2015_08:f',
            'SAS.sites.2015_08:f', 'EUR.sites.2015_08:f', 'EAS.sites.2015_08:f',
            'esp6500siv2_ea:f', 'esp6500siv2_all:f', 'esp6500siv2_aa:f',
            'popfreq_all_20150413:f',
            'abraom:f', 'hrcr1:f', 'kaviar_20150923:f',
            'cg69:f',
            'dbnsfp47a:f', 'dbscsnv11:f',
            'kgXref:f',
            'exac03nonpsych:f', 'exac03nontcga:f',
            'gnomad211_exome:f', 'gnomad211_genome:f',
            'gme:f', 'mcap:f', 'revel:f', 'nci60:f',
            'icgc28:f',
            'cosmic70:f',
            'clinvar_latest:f',
            'mitimpact24:f',
            'regsnpintron:f',
            'gerp++elem:f', 'gerp++gt2:f',
            'cadd13:f',
            'fathmm:f', 'gwava:f', 'eigen:f',
        ],
    ]
}

// The local executor schedules into max_cpus / max_memory (nextflow.config).
process.executor = 'local'

// Reuse one conda environment across runs / work directories (-profile dragen,conda).
conda.cacheDir = '/staging/adaniyarov/annovar-nf/conda_cache'
