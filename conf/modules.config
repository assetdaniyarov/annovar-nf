/*
================================================================================
    Publishing rules (what ends up in --outdir and where)
================================================================================
*/

process {
    // Not published: genome-build reports (shown in the summary HTML) and the
    // per-chunk ANNOVAR logs (printed on failure).
    withName: 'NORMALIZE_VCF' {
        publishDir = [
            path   : { "${params.outdir}/normalized/${meta.id}" },
            mode   : params.publish_dir_mode,
            pattern: '*.norm.vcf.gz',
            enabled: params.save_normalized.toString() == 'true'
        ]
    }
    withName: 'GATHER_CHUNKS|GATHER_VCF' {
        publishDir = [
            path   : { "${params.outdir}/annotation/${meta.id}" },
            mode   : params.publish_dir_mode,
            pattern: '*_multianno.{txt,txt.gz,vcf.gz,vcf.gz.tbi}'
        ]
    }
    withName: 'DB_AUDIT|DB_REAUDIT' {
        publishDir = [
            path   : { "${params.outdir}/database_check" },
            mode   : params.publish_dir_mode,
            pattern: '*.db_audit.*'
        ]
    }
    // Large packages (hg19 dbnsfp47a: 22 GB from a throttled server) take many
    // hours; withName beats the 2 h of the process_single label.
    withName: 'DB_DOWNLOAD|DB_INSTALL' {
        time = '72.h'
    }
    withName: 'DB_DOWNLOAD|DB_CLINVAR|DB_INSTALL|DB_GENES' {
        publishDir = [
            path   : { "${params.outdir}/database_check/logs" },
            mode   : params.publish_dir_mode,
            pattern: '*.log'
        ]
    }
    withName: 'ANNOTATION_SUMMARY' {
        publishDir = [
            path   : { "${params.outdir}/summary" },
            mode   : params.publish_dir_mode,
            pattern: '*annotation_summary*'
        ]
    }
}
