/*
================================================================================
    Test profile: end-to-end run on tiny VCFs with a mock ANNOVAR
    (tests/mock_annovar), so CI needs neither an ANNOVAR licence nor databases.
    Use with:  nextflow run main.nf -profile test
================================================================================
*/

params {
    input       = "${projectDir}/tests/data/samplesheet.csv"
    ped         = "${projectDir}/tests/data/cohort.ped"     // trio in cohort_hg19 (S1 affected)
    gene_panel  = "${projectDir}/tests/data/panel.txt"      // gene table: tests/mock_annovar/humandb
    outdir      = 'results_test'
    annovar_src = "${projectDir}/tests/mock_annovar"
    annovar_db  = "${projectDir}/tests/mock_annovar/humandb"
    genome      = 'auto'

    // Tiny chunks so the scatter/gather path is exercised.
    chunk_size  = 4
    threads     = 1

    max_cpus    = 2
    max_memory  = '6.GB'
    max_time    = '1.h'

    annovar_protocols = [
        hg19: ['refGene:g', 'clinvar_test:f', 'revel:f'],
        hg38: ['refGene:g', 'clinvar_test:f', 'revel:f', 'pubmind_db_v111:f'],
    ]
}
