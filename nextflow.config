/*
================================================================================
    annovar-nf: main configuration
    Defaults for every parameter live here; see `nextflow run main.nf --help`.
================================================================================
*/

manifest {
    name            = 'annovar-nf'
    author          = 'Asset Daniyarov'
    homePage        = 'https://github.com/assetdaniyarov/annovar-nf'
    description     = 'Nextflow pipeline for scalable multi-sample ANNOVAR annotation of VCF/BCF files (hg19/hg38)'
    mainScript      = 'main.nf'
    nextflowVersion = '!>=26.04.0'
    version         = '0.1.0'
    license         = 'MIT'
}

params {
    // Input / output
    input            = null
    input_pattern    = '*.{vcf,vcf.gz,vcf.bgz,gvcf.gz,bcf}'
    recursive        = false
    outdir           = './results'
    publish_dir_mode = 'copy'

    // Genome build: auto | hg19 | hg38
    genome           = 'auto'
    skip_build_check = false

    // ANNOVAR
    annovar_db       = null
    annovar_src      = null
    protocol         = null          // overrides params.annovar_protocols for all builds
    operation        = null
    onetranscript    = true
    annovar_args     = ''
    threads          = 8             // CPUs for ANNOVAR per input file: one chunk and process each
    skip_db_check    = false
    auto_install_db  = true          // install missing protocol databases before annotating

    // Database maintenance (--mode check_db | update_db)
    mode              = 'annotate'      // annotate | check_db | update_db
    db_builds         = null            // default: every build with a protocol
    clinvar_release   = 'latest'        // ClinVar built for 'clinvar_latest': latest | YYYYMMDD
    db_download_forks = 2
    db_offline        = false

    // Pre-processing
    chunk_size       = 1000000       // at most about this many records per chunk (0 = no splitting)
    pass_only        = false
    drop_genotypes   = false
    min_ac           = 0
    fasta_hg19       = null
    fasta_hg38       = null
    check_ref        = 'w'

    // Samples, families and genotype quality
    ped                = null        // PED file: families, sex, affected status (inheritance analysis, checks)
    skip_sample_qc     = false       // no per-sample QC (sex check, relatedness)
    family_max_samples = 10          // files with at most this many samples get the family analysis
    gene_info          = true        // report: GenCC diseases / modes of inheritance, gnomAD LOEUF per gene
    gene_panel         = null        // gene panel(s), comma-separated: gene lists or PanelApp TSV exports
    qc_min_dp          = 10          // genotype flags: LOW_DP below this read depth
    qc_min_gq          = 10          //                 LOW_GQ below this genotype quality
    qc_min_alt_reads   = 4           //                 LOW_ALT_READS: carriers with fewer alt reads
    qc_het_vaf         = '0.2,0.8'   //                 VAF_SKEW: heterozygous VAF outside MIN,MAX
    qc_min_hom_vaf     = 0.8         //                 VAF_SKEW: homozygous / hemizygous VAF below

    // Outputs
    compress_output  = true
    save_vcf         = false         // also write <id>.<build>_multianno.vcf.gz (+ .tbi)
    save_normalized  = false

    // Resource ceilings (applied through process.resourceLimits; with the
    // local executor also the capacity it schedules into). Default: the CPUs
    // and RAM of the machine Nextflow runs on, so --threads larger than the
    // machine is capped instead of failing. Cluster profiles set their own.
    max_cpus         = Runtime.getRuntime().availableProcessors()
    max_memory       = "${(java.lang.management.ManagementFactory.getOperatingSystemMXBean().getTotalMemorySize() / 1073741824).longValue()}.GB"
    max_time         = '240.h'

    // Execution
    slurm_queue      = null
    cluster_options  = null
    container        = 'ghcr.io/assetdaniyarov/annovar-nf:0.1.0'
    help             = false
    monochrome_logs  = false         // plain (uncoloured) messages, e.g. when logging to a file
    trace_report_suffix = new java.util.Date().format('yyyy-MM-dd_HH-mm-ss')
}

// Default ANNOVAR protocols per genome build
includeConfig 'conf/annovar_protocols.config'

// Resources and publishing
includeConfig 'conf/base.config'
includeConfig 'conf/modules.config'

profiles {
    standard {
        process.executor = 'local'
    }
    slurm {
        // Compute nodes are usually larger than the node Nextflow runs on.
        params.max_cpus        = 128
        params.max_memory      = '512.GB'
        process.executor       = 'slurm'
        process.queue          = params.slurm_queue
        process.clusterOptions = params.cluster_options
        executor {
            queueSize       = 100
            submitRateLimit = '20/1min'
        }
    }
    conda {
        conda.enabled     = true
        process.conda     = "${projectDir}/environment.yml"
        conda.channels    = ['conda-forge', 'bioconda']
    }
    mamba {
        conda.enabled     = true
        conda.useMamba    = true
        process.conda     = "${projectDir}/environment.yml"
        conda.channels    = ['conda-forge', 'bioconda']
    }
    docker {
        docker.enabled    = true
        docker.runOptions = '-u $(id -u):$(id -g)'
        process.container = params.container
    }
    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
        process.container      = "docker://${params.container}"
    }
    apptainer {
        apptainer.enabled    = true
        apptainer.autoMounts = true
        process.container    = "docker://${params.container}"
    }
    test {
        includeConfig 'conf/test.config'
    }
    dragen {
        includeConfig 'conf/dragen.config'
    }
}

// Resource ceilings and local executor capacity. Set after the profiles so a
// profile's max_* values are used (settings are evaluated in file order).
// Requests above the ceiling (e.g. --threads 120 on a 64-CPU machine) are
// capped instead of failing; the local executor schedules into the same limits.
process.resourceLimits = [
    cpus  : params.max_cpus.toString().toInteger(),
    memory: params.max_memory,
    time  : params.max_time
]
executor {
    cpus   = params.max_cpus.toString().toInteger()
    memory = params.max_memory
}

// Every process runs with strict bash error handling.
process.shell = ['/bin/bash', '-euo', 'pipefail']

// Keep user-site Python packages out of the pipeline environment.
env {
    PYTHONNOUSERSITE = '1'
}

timeline {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_timeline_${params.trace_report_suffix}.html"
}
report {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_report_${params.trace_report_suffix}.html"
}
trace {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_trace_${params.trace_report_suffix}.txt"
}
dag {
    enabled = true
    file    = "${params.outdir}/pipeline_info/pipeline_dag_${params.trace_report_suffix}.html"
}
